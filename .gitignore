# .gitignore — Flood Monitoring System

# ─── Credentials & Secrets ───────────────────────────────────────────────────
firmware/config.h
firmware/**/config.h
config/secrets.env
*.env
.env

# ─── Arduino / PlatformIO build artefacts ────────────────────────────────────
firmware/**/.pio/
firmware/**/build/
firmware/**/*.bin
firmware/**/*.elf
firmware/**/*.map

# ─── Node-RED ────────────────────────────────────────────────────────────────
node_modules/
.node_modules/
# flows_cred.json contains encrypted credentials — exclude if not encrypted
nodered/flows_cred.json
nodered/.node-red/flows_cred.json
# Chứa _credentialSecret dùng để giải mã flows_cred.json — tuyệt đối không commit
nodered/.node-red/.config.runtime.json*
nodered/.node-red/.config.*.json.backup
nodered/.node-red/.flows*.backup
nodered/.node-red/context/
nodered/.node-red/lib/
nodered/.node-red/.sessions.json

# ─── Mosquitto runtime data ───────────────────────────────────────────────────
mosquitto/data/mosquitto.db
mosquitto/data/*.log

# ─── Python / ML ─────────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.pyc
*.pyo
ml/.mpl/
ml/__pycache__/
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE ─────────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ─── Cloud & bridge (chứa mật khẩu) ─────────────────────────────────────────
mosquitto/conf.d/*.conf
cloud/.env
cloud/server/data/
nodered/.node-red/package-lock.json
!mosquitto/conf.d/00-default.conf
nodered/.node-red/.config.nodes.json
