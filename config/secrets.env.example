# Sao chép file này thành config/secrets.env rồi điền giá trị thật.
# config/secrets.env đã nằm trong .gitignore — không commit lên repo.
# start_all.ps1 nạp các biến này trước khi chạy Node-RED.

# Chat ID nhận cảnh báo (người quản lý / nhóm vận hành).
# Lấy bằng cách nhắn bot rồi mở https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# Write API Key của kênh ThingSpeak (field1..field6, xem README mục ThingSpeak)
THINGSPEAK_WRITE_API_KEY=XXXXXXXXXXXXXXXX

# Lưu ý: Bot Token nhập trong Node-RED (node cấu hình FloodAlertBot),
# được mã hoá trong nodered/.node-red/flows_cred.json (cũng không commit).
