# Cloud server chạy trên nền tảng chỉ mở HTTPS (Render.com…): broker MQTT tích hợp, gateway nối qua wss://<host>/mqtt
# Render tự build theo render.yaml ở gốc repo. Mật khẩu (ADMIN_TOKEN, EDGE_PASSWORD, VAPID_*) khai trong Environment
# của nền tảng — KHÔNG đặt trong file này.
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server.js broker.js nodes.json ./
COPY public ./public
# Gói miễn phí không có ổ đĩa lâu dài: CSDL ở /tmp (mất khi service khởi động lại). Nền tảng tự đặt PORT.
ENV NODE_ENV=production PORT=10000 BROKER=embedded DB_PATH=/tmp/flood/flood.db
USER node
EXPOSE 10000
CMD ["node", "--no-warnings", "server.js"]
