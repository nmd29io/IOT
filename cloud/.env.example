# Sao chép thành .env trên máy ảo rồi đổi TẤT CẢ giá trị. File .env không commit.

# Tên miền trỏ về IP máy ảo. Không có tên miền thì dùng dịch vụ miễn phí sslip.io:
#   IP 203.0.113.10  →  DOMAIN=203.0.113.10.sslip.io   (Caddy tự cấp HTTPS)
# Chỉ muốn HTTP (không HTTPS) thì đặt DOMAIN=:80
DOMAIN=203.0.113.10.sslip.io

# Mật khẩu MQTT cho gateway (điền giống trong mosquitto/conf.d/cloud-bridge.conf trên laptop)
EDGE_PASSWORD=doi-mat-khau-gateway

# Mật khẩu MQTT nội bộ cho server
SERVER_PASSWORD=doi-mat-khau-server

# Mã đăng nhập Web console quản lý (chuỗi dài, ngẫu nhiên)
ADMIN_TOKEN=doi-ma-quan-tri-that-dai
